<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
	<!--  Here first we have to create address bean -->
	<bean class = "in.cg.beans.Address" id = "Add">
		<constructor-arg name = "hNo" value = "5816"/>
		<constructor-arg name = "city" value = "Visakhapatnam"/>
		<constructor-arg name = "pincode" value = "530009"/>
	</bean>
	
	<!-- We are passing address bean id as ref -->
	<!-- Dependecy Injection is happening -->
	<!-- Through Constructor -->
	<bean class = "in.cg.beans.Student" id = "Std">
		<constructor-arg name = "id" value = "1001"/>
		<constructor-arg name = "name" value = "Sujith"/>
		<constructor-arg name = "email" value = "sujith@gmail.com"/>
		<constructor-arg name = "address" ref="Add"/>
	</bean>
	
</beans>
